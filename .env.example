# Copie ce fichier en `.env` puis renseigne les valeurs. Ne commite JAMAIS `.env`.

# ---- Google (Places API (New) + Maps JavaScript API) ----
# Restreins la clé dans la console Google Cloud (référents HTTP + APIs autorisées).
GOOGLE_MAPS_API_KEY="AIzaSyAhOHbhaSCnxnBNfQodIghcRD0Cl1PGDLE"

# ---- Sécurité ----
# Secret de signature des sessions (JWT). OBLIGATOIRE, 32 caractères minimum.
# Génère-le avec :  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Durée de validité d'une session, en heures
TOKEN_TTL_HOURS=12
# Autoriser la création de comptes (true/false). Le tout premier compte est toujours
# autorisé et devient administrateur. Passe à false une fois tes comptes créés.
ALLOW_REGISTRATION=true
# Origines autorisées par CORS (inutile si tu n'utilises que l'interface intégrée)
CORS_ORIGINS=http://localhost:8000

# ---- Envoi des CV par e-mail (optionnel) ----
# Sans SMTP_HOST et SMTP_FROM, le bouton « Envoyer » est désactivé (le lien mailto reste disponible).
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, et un « mot de passe d'application » (pas ton mot de passe habituel).
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587, recommandé) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Adresse expéditrice affichée (souvent identique à SMTP_USER) et nom affiché
SMTP_FROM=
SMTP_FROM_NAME=Career Finder
# Plafonds anti-spam par utilisateur
MAX_CV_PER_HOUR=10
MAX_CV_PER_DAY=30
